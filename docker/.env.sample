####
## [WIP, will added new sample creds later] Environment Variables for Weather Data Pipeline (Example)
## Copy this file to `.env` and replace all CHANGEME values.
## !! Do NOT commit your real `.env` to version control. !!
####

# ---------------------------
# Project / Compose
# ---------------------------
COMPOSE_PROJECT_NAME=weather-data-engineering-pipeline

# ---------------------------
# Airflow metadata DB (Postgres)
# ---------------------------
AIRFLOW_DB_USER=postgres
AIRFLOW_DB_PASS=CHANGEME_airflow_db_password
AIRFLOW_DB_HOST=postgres
AIRFLOW_DB_NAME=airflow

# ---------------------------
# PostgreSQL (DWH / app DB)
# Host & port are for docker networking. Exposed port is set in docker-compose.
# ---------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGEME_postgres_password
POSTGRES_DB=postgres
POSTGRES_PORT=5433

# ---------------------------
# Clickhouse (DWH / app DB)
# Host & port are for docker networking. Exposed port is set in docker-compose.
# ---------------------------
CLICKHOUSE_USER=ch_user
CLICKHOUSE_PASSWORD=CHANGEME_clickhouse_password
CLICKHOUSE_DB=weather
CLICKHOUSE_HTTP_PORT=8123               # HTTP (used by dbt, GE, Metabase plugin)
CLICKHOUSE_NATIVE_DRIVER_PORT=9000      # Native (used by clickhouse-driver)

# ---------------------------
# Metabase (uses Postgres as application DB)
# ---------------------------
METABASE_DB_TYPE=postgres
METABASE_DB_DBNAME=metabase
METABASE_DB_PORT=5432
METABASE_PORT=3002
METABASE_DB_USER=postgres
METABASE_DB_PASS=CHANGEME_metabase_db_password
METABASE_DB_HOST=postgres

# ---------------------------
# MinIO
# MINIO_KMS_SECRET_KEY format: <key-id>:<base64-encoded-32-bytes>
# Example base64 is placeholder—generate your own.
# ---------------------------
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=CHANGEME_minio_root_password
MINIO_ENDPOINT=minio:9000
MINIO_KMS_SECRET_KEY=my-minio-key:CHANGEME_base64_32_bytes_key
MINIO_BUCKET_L0_RAW=weather-bucket-raw
MINIO_BUCKET_L1_STAGING=weather-bucket-staging
MINIO_BUCKET_L2_CURATED=weather-bucket-curated
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# ---------------------------
# Adminer
# ---------------------------
ADMINER_PORT=8081

# ---------------------------
# dbt
# ---------------------------
DBT_TARGET=postgres

# Postgres
DBT_PG_HOST=host.docker.internal            # If using Docker Desktop, host.docker.internal is OK; otherwise set to 'postgres'
DBT_PG_USER=postgres
DBT_PG_PASSWORD=CHANGEME_dbt_pg_password
DBT_PG_PORT=5433
DBT_PG_DBNAME=postgres

# Clickhouse
DBT_CH_HOST=clickhouse
DBT_CH_PORT=8123
DBT_CH_USER=ch_user
DBT_CH_PASSWORD=CHANGEME_dbt_ch_password
DBT_CH_DATABASE=weather
DBT_CH_SCHEMA=dwh
DBT_CH_SECURE=false
DBT_CH_VERIFY=false

# ---------------------------
# Messaging (Telegram)
# NEVER commit real tokens. Fill in locally in your .env.
# ---------------------------
MESSAGING_BOT_TOKEN=CHANGEME_telegram_bot_token
MESSAGING_USER_ID=CHANGEME_telegram_chat_id
